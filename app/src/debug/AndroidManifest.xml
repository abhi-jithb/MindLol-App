<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG BUILDS ONLY. Gradle merges this file into debug builds; release builds never contain it.

    A test hook for the lock screen, so it can be tried without changing tonight's real rules.
    Protected by android.permission.DUMP: adb's shell holds it, normal apps can't get it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".debug.DebugLockActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
